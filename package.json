{
  "name": "product-engineering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manage product engineering records in your vault.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "vue-tsc -p configs/tsconfig.app.json && vue-tsc -p configs/tsconfig.node.json",
    "lint:ox": "oxlint --deny-warnings",
    "lint:es": "eslint --max-warnings 0 .",
    "lint": "npm run lint:ox && npm run lint:es",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config configs/vitest.config.ts",
    "test:coverage": "vitest run --config configs/vitest.config.ts --coverage",
    "fallow:config": "node scripts/fallow-config.mjs",
    "analyze": "node scripts/fallow-config.mjs --check && fallow -c configs/fallow.json && fallow architecture -c configs/fallow.json",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "eslint-plugin-oxlint": "1.94.0",
    "eslint-plugin-vue": "10.12.1",
    "fallow": "3.46.0",
    "globals": "17.14.0",
    "obsidian": "1.14.4",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
