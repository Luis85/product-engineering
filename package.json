{
  "name": "product-engineering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manage product engineering records in your vault.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "vue-tsc -p configs/tsconfig.app.json && vue-tsc -p configs/tsconfig.node.json && tsc -p tests/e2e/tsconfig.json",
    "lint:ox": "oxlint --deny-warnings",
    "lint:es": "eslint --max-warnings 0 .",
    "lint": "npm run lint:ox && npm run lint:es",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config configs/vitest.config.ts",
    "test:coverage": "vitest run --config configs/vitest.config.ts --coverage",
    "test:e2e": "npm run build && wdio run tests/e2e/wdio.conf.mts",
    "fallow:config": "node scripts/fallow-config.mjs",
    "analyze": "node scripts/fallow-config.mjs --check && fallow -c configs/fallow.json && fallow architecture -c configs/fallow.json",
    "build": "vite build --config configs/vite.config.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "dev": "node scripts/dev-install.mjs",
    "dev:ui": "vite --config configs/vite.harness.config.ts",
    "build:ui": "vite build --config configs/vite.harness.config.ts",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@eslint/js": "9.39.5",
    "@iconify-json/lucide": "1.2.158",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "eslint-plugin-oxlint": "1.94.0",
    "eslint-plugin-vue": "10.12.1",
    "fallow": "3.46.0",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "mocha": "12.0.3",
    "obsidian": "1.14.4",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "wdio-obsidian-reporter": "3.5.0",
    "wdio-obsidian-service": "3.5.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9",
    "glob@>=9.0.0 <14.0.2": "14.0.6"
  },
  "dependencies": {
    "@iconify/vue": "5.0.5",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nuxt/ui": "4.13.0",
    "@tanstack/ai": "1.8.0",
    "@tanstack/vue-form": "1.33.5",
    "effect": "4.1.5",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46"
  }
}
